# Copia este archivo como ".env" y completa los valores.
# El archivo .env NUNCA se sube a git ni se entrega dentro del instalador.

# --- Seguridad ---
# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Servidor local (solo para el programa empaquetado) ---
HOST=127.0.0.1
PORT=8000

# --- Rutas de datos (opcionales; omitir la variable para usar el valor por defecto) ---
# No activar variables de ruta vacías.
# DATA_DIR=C:\ProgramData\SistemaInventarios
# DB_PATH=
# BACKUP_DIR=
# LOG_DIR=

# --- Negocio ---
NOMBRE_NEGOCIO=Mi tienda
MONEDA_SIMBOLO=Bs
# Enteros mayores o iguales a cero.
DIAS_ALERTA_VENCIMIENTO=30
STOCK_MINIMO_DEFECTO=5
# Entero mayor o igual a uno.
BACKUP_CONSERVAR=30

# --- Idioma y hora ---
LANGUAGE_CODE=es
TIME_ZONE=America/La_Paz

# --- Sesión y registros ---
# Duración positiva en segundos.
SESSION_COOKIE_AGE=28800
# DEBUG, INFO, WARNING, ERROR o CRITICAL.
LOG_LEVEL=INFO
